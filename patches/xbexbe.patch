+bool ShaderTraceSpan(uint32_t address, uint32_t bytes) {
+    uint64_t end = uint64_t(address) + bytes;
+    if (!address || end > (uint64_t(1) << 32)) return false;
+    for (uint64_t page = address & ~(mem::kPage - 1u); page < end; page += mem::kPage)
+        if (!mem::IsCommitted(uint32_t(page))) return false;
+    return true;
+}
+
+void TraceVertexProgram(X86Context& ctx, uint32_t program, uint32_t slot) {
+    if (!diag::Perf()) return;
+    static std::atomic<unsigned> calls{0};
+    unsigned call = calls.fetch_add(1, std::memory_order_relaxed);
+    if (call >= 32) return;
+    uint32_t caller = ShaderTraceSpan(ctx.esp, 4) ? R32(ctx.esp) : 0;
+    if (!ShaderTraceSpan(program, 4)) {
+        LOGR("d3d raw-vp call=%u caller=%08X program=%08X slot=%u unreadable header; host upload",
+             call, caller, program, slot);
+        return;
+    }
+    uint32_t header = R32(program), count = header >> 16;
+    // The header type is diagnostic only: the original raw uploader ignores its low16 bits.
+    constexpr uint32_t slots = 136;
+    bool bounded = slot <= slots && count <= slots - slot;
+    bool readable = bounded && ShaderTraceSpan(program, 4 + count * 16);
+    LOGR("d3d raw-vp call=%u caller=%08X program=%08X slot=%u header=%08X instructions=%u capture=%s; host upload",
+         call, caller, program, slot, header, count, !bounded ? "outside136slots" : readable ? "complete" : "unreadable");
+    if (!readable) return;
+    std::array<uint32_t, slots * 4> words{};
+    std::memcpy(words.data(), HostPtr(program + 4), count * 16);
+    for (uint32_t first = 0; first < count * 4; first += 32) {
+        char line[32 * 9 + 1]{};
+        uint32_t n = std::min(32u, count * 4 - first);
+        for (uint32_t i = 0; i < n; i++) std::snprintf(line + i * 9, 10, "%08X ", words[first + i]);
+        LOGR("d3d raw-vp words call=%u first=%u count=%u %s", call, first, n, line);
+    }
+}
