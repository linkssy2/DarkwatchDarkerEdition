+void SetVertexSelectionState(uint32_t handle, uint32_t start) {
+    g_state.vs_handle = handle;
+    // Public query state is distinct from the SDK's private declaration object pointer.
+    if (XDK_CDevice_VertexShaderHandle != xdk::kUnknown) SetDev(XDK_CDevice_VertexShaderHandle, handle);
+    if (XDK_CDevice_VertexProgramStart != xdk::kUnknown) SetDev(XDK_CDevice_VertexProgramStart, start);
+}
+
+uint32_t ReadVertexProgram(const VertexProgramState& bank, uint32_t start, std::vector<uint32_t>& words) {
+    words.clear();
+    for (uint32_t i = start; i < kVertexProgramSlots; i++) {
+        if (!bank.valid[i]) return VertexProgramError("selection reaches an unloaded instruction", 0x80004005u);
+        const auto& w = bank.words[i];
+        uint32_t mac = w[1] >> 21 & 15, ilu = w[1] >> 25 & 7;
+        bool output = (w[3] & 0xF000) && ((w[3] & 4) ? ilu != 0 : mac != 0 && mac != 13);
+        if (mac > 13 || (output && !(w[3] & 0x800)))
+            return VertexProgramError("opcode or constant-writing instruction is unsupported", 0x80004001u);
+        words.insert(words.end(), w.begin(), w.end());
+        if (w[3] & 1) return 0;
+    }
+    return VertexProgramError("selection has no final instruction", 0x80004005u);
+}
+
+void PublishVertexProgram(VertexProgramState bank, const std::vector<uint32_t>& words, uint32_t handle) {
+    // A submitted shader owns its words. Replacing the active range must not mutate queued draws or their cached hash.
+    if (g_vertex_program.error || g_vertex_program.declaration != bank.declaration || !g_state.vs ||
+        g_state.vs->program_type != 0x2078 || g_state.vs->program != words) {
+        auto effective = std::make_shared<gpu::VertexShader>(*bank.declaration);
+        effective->program = words;
+        effective->program_type = 0x2078;
+        effective->hash = 0;
+        g_state.vs = std::move(effective);
+    }
+    g_state.vs_handle = handle;
+    bank.error = 0;
+    g_vertex_program = std::move(bank);
+}
+
+uint32_t WriteVertexProgram(VertexProgramState& bank, uint32_t slot, const uint32_t* words, uint32_t count) {
+    if (slot > kVertexProgramSlots || count > kVertexProgramSlots - slot)
+        return VertexProgramError("upload range exceeds instruction memory", 0x80070057u);
+    for (uint32_t i = 0; i < count; i++) {
+        std::copy_n(words + i * 4, 4, bank.words[slot + i].begin());
+        bank.valid[slot + i] = true;
+    }
+    return 0;
+}
+
+uint32_t CommitVertexUpload(VertexProgramState bank) {
+    if (bank.selected) {
+        std::vector<uint32_t> words;
+        if (uint32_t error = ReadVertexProgram(bank, bank.start, words)) {
+            // Instruction writes persist, including split uploads. Block draws until the selected range is executable.
+            bank.error = error;
+            g_vertex_program = std::move(bank);
+            return error;
+        }
+        PublishVertexProgram(std::move(bank), words, g_state.vs_handle);
+    } else {
+        bank.error = 0;
+        g_vertex_program = std::move(bank);
+    }
+    return 0;
+}
+
+uint32_t LoadVertexProgramHandle(const std::shared_ptr<gpu::VertexShader>& shader, uint32_t slot, bool select) {
+    if (shader->program_type && shader->program_type != 0x2078)
+        return VertexProgramError("state/read-write shader type is unsupported", 0x80004001u);
+    if (shader->program.size() % 4 || shader->program.size() / 4 > kVertexProgramSlots)
+        return VertexProgramError("stored program length is invalid", 0x80070057u);
+    Walk(Dev(kDevPush));  // earlier raw constants precede this handle's declaration constants
+    auto bank = g_vertex_program;
+    if (uint32_t error = WriteVertexProgram(bank, slot, shader->program.data(), uint32_t(shader->program.size() / 4))) return error;
+    if (select) {
+        bank.declaration = shader;
+        bank.start = slot;
+        bank.selected = !shader->program.empty();
+    }
+    uint32_t error = CommitVertexUpload(std::move(bank));
