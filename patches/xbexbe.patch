+void LogCrashContext(EXCEPTION_POINTERS* e) {
+    if (e && e->ExceptionRecord && e->ExceptionRecord->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+        e->ExceptionRecord->NumberParameters >= 2) {
+        const auto* r = e->ExceptionRecord;
+        const auto address = r->ExceptionInformation[1];
+        const auto base = reinterpret_cast<uintptr_t>(kernel::g_base);
+        LOGE("  access %llu address %llX", static_cast<unsigned long long>(r->ExceptionInformation[0]),
+             static_cast<unsigned long long>(address));
+        if (kernel::g_base && address >= base && address - base <= UINT32_MAX)
+            LOGE("  guest address %08X", uint32_t(address - base));
+    }
+    auto* thread = kernel::Current();
+    X86Context ctx{};
+    SIZE_T bytes = 0;
+    if (!thread || !thread->ctx || !ReadProcessMemory(GetCurrentProcess(), thread->ctx, &ctx, sizeof(ctx), &bytes) ||
+        bytes != sizeof(ctx)) return;
+    LOGE("  eax %08X ecx %08X edx %08X ebx %08X esp %08X ebp %08X esi %08X edi %08X",
+         ctx.eax, ctx.ecx, ctx.edx, ctx.ebx, ctx.esp, ctx.ebp, ctx.esi, ctx.edi);
+    if (!kernel::g_base) return;
+    for (unsigned i = 0; i < 64; ++i) {
+        const uint64_t address = uint64_t(ctx.esp) + i * 4;
+        if (address > UINT32_MAX - 3) break;
+        uint32_t value = 0;
+        if (!ReadProcessMemory(GetCurrentProcess(), kernel::g_base + address, &value, sizeof(value), &bytes) ||
+            bytes != sizeof(value)) break;
+        if (value >= X86CodeBase && value < X86CodeEnd)
+            LOGE("  candidate return [esp+%03X] %08X", i * 4, value);
+    }
+}
 
