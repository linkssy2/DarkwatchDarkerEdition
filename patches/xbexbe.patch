+struct FramePerf {
+    Perf before;
+    PerfClock::time_point previous{};
+    bool started = false;
+    uint64_t slow_frames = 0, worst_frame = 0;
+    double worst_gap = 0;
+    bool worst_capture = false;
+    Perf worst_begin, worst_end;
