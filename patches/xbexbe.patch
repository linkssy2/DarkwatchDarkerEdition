+#include <cassert>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+#include "gpu/xegtao/XeGTAO.h"
+
+namespace gpu {
+namespace {
+using Microsoft::WRL::ComPtr;
+
+const char* kTypes =
+#include "gpu/xegtao/types.inl"
+;
+const char* kCore =
+#include "gpu/xegtao/core.inl"
+;
+constexpr char kDeclarations[] = R"(
+#define VA_SATURATE saturate
+#define XE_GTAO_USE_HALF_FLOAT_PRECISION 0
+#define XE_GTAO_FP32_DEPTHS
+#define XE_GTAO_GENERATE_NORMALS_INPLACE
+)";
+constexpr char kConstants[] = R"(
+cbuffer Constants : register(b0) { GTAOConstants gtao; }
+cbuffer Region : register(b1) { uint2 origin; uint2 extent; float strength; float3 padding; }
+SamplerState pointClamp : register(s0);
+)";
+constexpr char kCrop[] = R"(
+Texture2D<float> source : register(t0);
+RWTexture2D<float> cropped : register(u0);
+[numthreads(8,8,1)] void crop(uint2 p : SV_DispatchThreadID) {
+    if (all(p < extent)) cropped[p] = source.Load(int3(origin + p, 0));
+}
+)";
+constexpr char kPrefilter[] = R"(
+Texture2D<float> source : register(t0);
+RWTexture2D<lpfloat> mip0 : register(u0);
+RWTexture2D<lpfloat> mip1 : register(u1);
+RWTexture2D<lpfloat> mip2 : register(u2);
+RWTexture2D<lpfloat> mip3 : register(u3);
+RWTexture2D<lpfloat> mip4 : register(u4);
+[numthreads(8,8,1)] void prefilter(uint2 p : SV_DispatchThreadID, uint2 g : SV_GroupThreadID) {
+    XeGTAO_PrefilterDepths16x16(p, g, gtao, source, pointClamp, mip0, mip1, mip2, mip3, mip4);
+}
+)";
+constexpr char kMain[] = R"(
+Texture2D<lpfloat> source : register(t0);
+RWTexture2D<uint> ao : register(u0);
+RWTexture2D<unorm float> edges : register(u1);
+[numthreads(8,8,1)] void mainAO(uint2 p : SV_DispatchThreadID) {
+    if (any(p >= extent)) return;
+    uint index = HilbertIndex(p.x, p.y);
+    float2 noise = frac(0.5 + index * float2(0.75487766624669276005, 0.5698402909980532659114));
+    XeGTAO_MainPass(p, 4, 4, noise, float3(0,0,0), gtao, source, pointClamp, ao, edges);
+}
+)";
+constexpr char kDenoise[] = R"(
+Texture2D<uint> ao : register(t0);
+Texture2D<lpfloat> edges : register(t1);
+RWTexture2D<uint> outputAO : register(u0);
+[numthreads(8,8,1)] void denoise(uint2 p : SV_DispatchThreadID) {
+    if (any(p * uint2(2,1) >= extent)) return;
+    XeGTAO_Denoise(p * uint2(2,1), gtao, ao, edges, pointClamp, outputAO, false);
+}
+[numthreads(8,8,1)] void denoiseLast(uint2 p : SV_DispatchThreadID) {
+    if (any(p * uint2(2,1) >= extent)) return;
+    XeGTAO_Denoise(p * uint2(2,1), gtao, ao, edges, pointClamp, outputAO, true);
+}
+)";
+constexpr char kComposite[] = R"(
+cbuffer Region : register(b1) { uint2 origin; uint2 extent; float strength; float3 padding; }
+Texture2D<uint> ao : register(t0);
+Texture2D<float> rawDepth : register(t1);
+float4 vs(uint id : SV_VertexID) : SV_Position {
+    float2 p = float2((id << 1) & 2, id & 2);
+    return float4(p * float2(2,-2) + float2(-1,1), 0, 1);
+}
+float4 composite(float4 position : SV_Position) : SV_Target {
+    int2 p = int2(position.xy) - int2(origin);
+    float visibility = ao.Load(int3(p, 0)) / 255.0;
+    // Clear sky must remain unchanged even at silhouette edges.
+    float factor = rawDepth.Load(int3(p, 0)) >= 0.999999 ? 1.0 : lerp(1.0, saturate(visibility), strength);
+    return float4(factor.xxx, 1);
+}
+)";
+
+constexpr uint32_t kPasses = 6, kDescriptorsPerPass = 7;
+constexpr auto kShaderRead = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr auto kPixelRead = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+struct Region { uint32_t x, y, width, height; float strength = 1.0f; float pad[3]{}; };
+static_assert(sizeof(XeGTAO::GTAOConstants) == 96);
+static_assert(sizeof(Region) == 32);
+
+struct Texture {
+    ComPtr<ID3D12Resource> resource;
+    D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+    DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+};
+void Transition(ID3D12GraphicsCommandList* list, Texture& texture, D3D12_RESOURCE_STATES wanted) {
+    if (texture.state == wanted) return;
+    D3D12_RESOURCE_BARRIER barrier{};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition = {texture.resource.Get(), D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, texture.state, wanted};
+    list->ResourceBarrier(1, &barrier);
+    texture.state = wanted;
+}
+bool MakeTexture(ID3D12Device* device, Texture& texture, uint32_t width, uint32_t height,
+                 DXGI_FORMAT format, uint16_t levels = 1) {
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = levels;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    texture.format = format;
+    return SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+        D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&texture.resource)));
+}
+void Srv(ID3D12Device* device, ID3D12Resource* resource, DXGI_FORMAT format,
+         D3D12_CPU_DESCRIPTOR_HANDLE view, uint32_t mips = 1) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC desc{};
+    desc.Format = format;
+    desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    desc.Texture2D.MipLevels = mips;
+    device->CreateShaderResourceView(resource, &desc, view);
+}
+void Uav(ID3D12Device* device, ID3D12Resource* resource, DXGI_FORMAT format,
+         D3D12_CPU_DESCRIPTOR_HANDLE view, uint32_t mip = 0) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC desc{};
+    desc.Format = format;
+    desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    desc.Texture2D.MipSlice = mip;
+    device->CreateUnorderedAccessView(resource, nullptr, &desc, view);
+}
+
+struct Pipelines {
+    ComPtr<ID3D12RootSignature> root;
+    std::array<ComPtr<ID3D12PipelineState>, 5> compute;
+    ComPtr<ID3DBlob> vertex, pixel;
+    struct Composite {
+        DXGI_FORMAT format;
+        DXGI_SAMPLE_DESC samples;
+        ComPtr<ID3D12PipelineState> state;
+    };
+    std::vector<Composite> composite;
+
+    bool Initialize(ID3D12Device* device, const Gtao::Compile& compile) {
+        D3D12_DESCRIPTOR_RANGE ranges[2]{};
+        ranges[0] = {D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 2, 0, 0, 0};
+        ranges[1] = {D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 5, 0, 0, 0};
+        D3D12_ROOT_PARAMETER params[4]{};
+        for (uint32_t i = 0; i < 2; ++i) {
+            params[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+            params[i].DescriptorTable = {1, &ranges[i]};
+        }
+        params[2].ParameterType = params[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        params[2].Constants = {0, 0, sizeof(XeGTAO::GTAOConstants) / 4};
+        params[3].Constants = {1, 0, sizeof(Region) / 4};
+        D3D12_STATIC_SAMPLER_DESC sampler{};
+        sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+        sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+        sampler.MaxLOD = std::numeric_limits<float>::max();
+        sampler.MaxAnisotropy = 1;
+        D3D12_ROOT_SIGNATURE_DESC desc{4, params, 1, &sampler, D3D12_ROOT_SIGNATURE_FLAG_NONE};
+        ComPtr<ID3DBlob> blob, errors;
+        if (FAILED(D3D12SerializeRootSignature(&desc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &errors)) ||
+            FAILED(device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&root)))) return false;
+        const auto& shaders = Gtao::ShaderSources();
+        for (uint32_t i = 0; i < compute.size(); ++i) {
+            const auto& shader = shaders[i];
+            ID3DBlob* code = compile(shader.source, shader.entry, shader.profile);
+            if (!code) return false;
+            D3D12_COMPUTE_PIPELINE_STATE_DESC pso{};
+            pso.pRootSignature = root.Get();
+            pso.CS = {code->GetBufferPointer(), code->GetBufferSize()};
+            if (FAILED(device->CreateComputePipelineState(&pso, IID_PPV_ARGS(&compute[i])))) return false;
+        }
+        vertex = compile(shaders[5].source, shaders[5].entry, shaders[5].profile);
+        pixel = compile(shaders[6].source, shaders[6].entry, shaders[6].profile);
+        return vertex && pixel;
+    }
+    ID3D12PipelineState* CompositeState(ID3D12Device* device, DXGI_FORMAT format, DXGI_SAMPLE_DESC samples) {
+        for (const auto& p : composite)
+            if (p.format == format && p.samples.Count == samples.Count && p.samples.Quality == samples.Quality) return p.state.Get();
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC desc{};
+        desc.pRootSignature = root.Get();
+        desc.VS = {vertex->GetBufferPointer(), vertex->GetBufferSize()};
+        desc.PS = {pixel->GetBufferPointer(), pixel->GetBufferSize()};
+        auto& blend = desc.BlendState.RenderTarget[0];
+        blend.BlendEnable = TRUE;
+        blend.SrcBlend = D3D12_BLEND_ZERO;
+        blend.DestBlend = D3D12_BLEND_SRC_COLOR;
+        blend.BlendOp = D3D12_BLEND_OP_ADD;
+        blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+        blend.DestBlendAlpha = D3D12_BLEND_ONE;
+        blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+        blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_RED | D3D12_COLOR_WRITE_ENABLE_GREEN | D3D12_COLOR_WRITE_ENABLE_BLUE;
+        desc.SampleMask = UINT_MAX;
+        desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        desc.RasterizerState.DepthClipEnable = TRUE;
+        desc.RasterizerState.MultisampleEnable = samples.Count > 1;
+        desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        desc.NumRenderTargets = 1;
+        desc.RTVFormats[0] = format;
+        desc.SampleDesc = samples;
+        Composite p{format, samples, {}};
+        if (FAILED(device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&p.state)))) return nullptr;
+        composite.push_back(std::move(p));
+        return composite.back().state.Get();
+    }
+};
+
+struct Frame {
+    uint32_t width = 0, height = 0, stride = 0;
+    ComPtr<ID3D12DescriptorHeap> views;
+    Texture crop, depth, edges;
+    std::array<Texture, 3> ao;
+    // Retain inputs and every pipeline object even if Reset destroys the pool.
+    ComPtr<ID3D12Resource> input_depth, input_color;
+    std::shared_ptr<Pipelines> pipelines;
+    D3D12_CPU_DESCRIPTOR_HANDLE Cpu(uint32_t pass, uint32_t index) const {
+        auto handle = views->GetCPUDescriptorHandleForHeapStart();
+        handle.ptr += SIZE_T(pass * kDescriptorsPerPass + index) * stride;
+        return handle;
+    }
+    D3D12_GPU_DESCRIPTOR_HANDLE Gpu(uint32_t pass, uint32_t index) const {
+        auto handle = views->GetGPUDescriptorHandleForHeapStart();
+        handle.ptr += UINT64(pass * kDescriptorsPerPass + index) * stride;
+        return handle;
+    }
+    bool Initialize(ID3D12Device* device, uint32_t w, uint32_t h) {
+        width = w; height = h;
+        stride = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        D3D12_DESCRIPTOR_HEAP_DESC heap{};
+        heap.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        heap.NumDescriptors = kPasses * kDescriptorsPerPass;
+        heap.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(device->CreateDescriptorHeap(&heap, IID_PPV_ARGS(&views))) ||
+            !MakeTexture(device, crop, w, h, DXGI_FORMAT_R32_FLOAT) ||
+            !MakeTexture(device, depth, w, h, DXGI_FORMAT_R32_FLOAT, 5) ||
+            !MakeTexture(device, edges, w, h, DXGI_FORMAT_R8_UNORM)) return false;
+        for (auto& image : ao) if (!MakeTexture(device, image, w, h, DXGI_FORMAT_R8_UINT)) return false;
+        // Fully initialize unused table entries too; no descriptor inherits a
+        // previous player's inputs or references an unbound resource.
+        for (uint32_t p = 0; p < kPasses; ++p) {
+            for (uint32_t i = 0; i < 2; ++i) Srv(device, nullptr, DXGI_FORMAT_R32_FLOAT, Cpu(p, i));
+            for (uint32_t i = 0; i < 5; ++i) Uav(device, nullptr, DXGI_FORMAT_R32_FLOAT, Cpu(p, i + 2));
+        }
+        Uav(device, crop.resource.Get(), crop.format, Cpu(0, 2));
+        Srv(device, crop.resource.Get(), crop.format, Cpu(1, 0));
+        for (uint32_t m = 0; m < 5; ++m) Uav(device, depth.resource.Get(), depth.format, Cpu(1, m + 2), m);
+        Srv(device, depth.resource.Get(), depth.format, Cpu(2, 0), 5);
+        Uav(device, ao[0].resource.Get(), ao[0].format, Cpu(2, 2));
+        Uav(device, edges.resource.Get(), edges.format, Cpu(2, 3));
+        for (uint32_t p = 3; p <= 4; ++p) {
+            Srv(device, ao[p - 3].resource.Get(), ao[p - 3].format, Cpu(p, 0));
+            Srv(device, edges.resource.Get(), edges.format, Cpu(p, 1));
+            Uav(device, ao[p - 2].resource.Get(), ao[p - 2].format, Cpu(p, 2));
+        }
+        Srv(device, ao[2].resource.Get(), ao[2].format, Cpu(5, 0));
+        Srv(device, crop.resource.Get(), crop.format, Cpu(5, 1));
+        return true;
+    }
+};
+} // namespace
+
+struct Gtao::Impl {
+    ComPtr<ID3D12Device> device;
+    std::shared_ptr<Pipelines> pipelines;
+    std::vector<std::shared_ptr<Frame>> frames;
+};
+Gtao::Gtao() : impl_(std::make_unique<Impl>()) {}
+Gtao::~Gtao() = default;
+void Gtao::Reset() { impl_ = std::make_unique<Impl>(); }
+
+const std::array<Gtao::Shader, 7>& Gtao::ShaderSources() {
+    static const auto sources = [] {
+        const std::string base = std::string(kDeclarations) + kTypes + kConstants;
+        const std::string core = base + kCore;
+        return std::array<Shader, 7>{{
+            {base + kCrop, "crop", "cs_5_0"},
+            {core + kPrefilter, "prefilter", "cs_5_0"},
+            {core + kMain, "mainAO", "cs_5_0"},
+            {core + kDenoise, "denoise", "cs_5_0"},
+            {core + kDenoise, "denoiseLast", "cs_5_0"},
+            {kComposite, "vs", "vs_5_0"},
+            {kComposite, "composite", "ps_5_0"}
+        }};
+    }();
+    return sources;
+}
+
+Gtao::Result Gtao::Execute(ID3D12Device* device, ID3D12GraphicsCommandList* list,
+                          const Input& in, const Compile& compile) {
+    if (!device || !list || !in.depth || !in.color || !in.color_view.ptr || !compile ||
+        in.depth == in.color || in.viewport.left < 0 || in.viewport.top < 0 ||
+        in.viewport.right <= in.viewport.left || in.viewport.bottom <= in.viewport.top) return {};
+    const auto ds = in.depth->GetDesc(), rt = in.color->GetDesc();
+    const uint32_t w = uint32_t(in.viewport.right - in.viewport.left), h = uint32_t(in.viewport.bottom - in.viewport.top);
+    if (w < 16 || h < 16 || ds.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+        rt.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || ds.SampleDesc.Count != 1 ||
+        ds.DepthOrArraySize != 1 || rt.DepthOrArraySize != 1 ||
+        uint64_t(in.viewport.right) > ds.Width || uint32_t(in.viewport.bottom) > ds.Height ||
+        uint64_t(in.viewport.right) > rt.Width || uint32_t(in.viewport.bottom) > rt.Height ||
+        (in.depth_format != DXGI_FORMAT_R24_UNORM_X8_TYPELESS && in.depth_format != DXGI_FORMAT_R32_FLOAT &&
+         in.depth_format != DXGI_FORMAT_R16_UNORM)) return {};
+    for (float v : in.projection) if (!std::isfinite(v)) return {};
+    // Intel's reconstruction helper uses the standard centered LH projection.
+    // Reject oblique/off-center cameras instead of silently shading wrong depth.
+    if (in.projection[0] <= 0.00001f || in.projection[5] <= 0.00001f ||
+        std::abs(in.projection[11] - 1.0f) > 0.00001f) return {};
+    for (uint32_t i : {1u, 2u, 3u, 4u, 6u, 7u, 8u, 9u, 12u, 13u, 15u})
+        if (std::abs(in.projection[i]) > 0.00001f) return {};
+    XeGTAO::GTAOConstants constants{};
+    XeGTAO::GTAOSettings settings;
+    settings.QualityLevel = 1;
+    settings.DenoisePasses = 2;
+    XeGTAO::GTAOUpdateConstants(constants, int(w), int(h), settings, in.projection.data(), true, 0);
+    if (!(constants.DepthUnpackConsts.x > 0 && constants.DepthUnpackConsts.y >= 1)) return {};
+
+    if (impl_->device.Get() != device) { Reset(); impl_->device = device; }
+    if (!impl_->pipelines) {
+        auto pipelines = std::make_shared<Pipelines>();
+        if (!pipelines->Initialize(device, compile)) return {};
+        impl_->pipelines = std::move(pipelines);
+    }
+    auto* composite = impl_->pipelines->CompositeState(device, in.color_format, rt.SampleDesc);
+    if (!composite) return {};
+    std::shared_ptr<Frame> frame;
+    for (auto& available : impl_->frames) {
+        if (available.use_count() == 1 && available->width == w && available->height == h) { frame = available; break; }
+    }
+    if (!frame) {
+        // Discard only fence-completed slots; caller tokens keep outstanding
+        // dimensions alive across settings changes and device resets.
+        std::erase_if(impl_->frames, [](const auto& p) { return p.use_count() == 1; });
+        frame = std::make_shared<Frame>();
+        if (!frame->Initialize(device, w, h)) return {};
+        impl_->frames.push_back(frame);
+    }
+    frame->input_depth = in.depth;
+    frame->input_color = in.color;
+    frame->pipelines = impl_->pipelines;
+    Srv(device, in.depth, in.depth_format, frame->Cpu(0, 0));
+    ID3D12DescriptorHeap* heaps[] = {frame->views.Get()};
+    list->SetDescriptorHeaps(1, heaps);
+    list->SetComputeRootSignature(impl_->pipelines->root.Get());
+    list->SetComputeRoot32BitConstants(2, sizeof(constants) / 4, &constants, 0);
+    const Region region{uint32_t(in.viewport.left), uint32_t(in.viewport.top), w, h};
+    list->SetComputeRoot32BitConstants(3, sizeof(region) / 4, &region, 0);
+    auto dispatch = [&](uint32_t pass, uint32_t x, uint32_t y) {
+        list->SetPipelineState(impl_->pipelines->compute[pass].Get());
+        list->SetComputeRootDescriptorTable(0, frame->Gpu(pass, 0));
+        list->SetComputeRootDescriptorTable(1, frame->Gpu(pass, 2));
+        list->Dispatch(x, y, 1);
+    };
+    Transition(list, frame->crop, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    dispatch(0, (w + 7) / 8, (h + 7) / 8);
+    Transition(list, frame->crop, kShaderRead);
+    Transition(list, frame->depth, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    dispatch(1, (w + 15) / 16, (h + 15) / 16);
+    Transition(list, frame->depth, kShaderRead);
+    Transition(list, frame->ao[0], D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Transition(list, frame->edges, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    dispatch(2, (w + 7) / 8, (h + 7) / 8);
+    Transition(list, frame->ao[0], kShaderRead);
+    Transition(list, frame->edges, kShaderRead);
+    Transition(list, frame->ao[1], D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    dispatch(3, (w + 15) / 16, (h + 7) / 8);
+    Transition(list, frame->ao[1], kShaderRead);
+    Transition(list, frame->ao[2], D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    dispatch(4, (w + 15) / 16, (h + 7) / 8);
+    Transition(list, frame->ao[2], kPixelRead);
+    Transition(list, frame->crop, kPixelRead);
+    list->SetGraphicsRootSignature(impl_->pipelines->root.Get());
+    list->SetGraphicsRootDescriptorTable(0, frame->Gpu(5, 0));
+    list->SetGraphicsRootDescriptorTable(1, frame->Gpu(5, 2));
+    list->SetGraphicsRoot32BitConstants(2, sizeof(constants) / 4, &constants, 0);
+    list->SetGraphicsRoot32BitConstants(3, sizeof(region) / 4, &region, 0);
+    list->SetPipelineState(composite);
+    list->OMSetRenderTargets(1, &in.color_view, FALSE, nullptr);
+    const D3D12_VIEWPORT viewport{float(in.viewport.left), float(in.viewport.top), float(w), float(h), 0, 1};
+    list->RSSetViewports(1, &viewport);
+    list->RSSetScissorRects(1, &in.viewport);
+    list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    list->DrawInstanced(3, 1, 0, 0);
+    Result result{true, frame};
+#ifndef XBE_RELEASE
+    result.capture.depth = frame->crop.resource.Get();
+    result.capture.linear_depth = frame->depth.resource.Get();
+    result.capture.visibility = frame->ao[2].resource.Get();
+    std::memcpy(result.capture.constants.data(), &constants, sizeof(constants));
+#endif
+    return result;
+}
+} // namespace gpu
