+uint32_t D3D12Backend::SelectSamples(uint32_t requested) const {
+    uint32_t samples = requested == 4 || requested == 2 ? requested : 1;
+    const auto supports = [&](DXGI_FORMAT fmt, uint32_t n) {
+        D3D12_FEATURE_DATA_MULTISAMPLE_QUALITY_LEVELS q{fmt, n, D3D12_MULTISAMPLE_QUALITY_LEVELS_FLAG_NONE, 0};
+        return SUCCEEDED(dev_->CheckFeatureSupport(D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS, &q, sizeof(q))) &&
+               q.NumQualityLevels != 0;
+    };
+    for (; samples > 1; samples /= 2) {
+        bool ok = supports(kBgra, samples) && supports(DXGI_FORMAT_D24_UNORM_S8_UINT, samples) &&
+                  supports(DXGI_FORMAT_R16G16B16A16_FLOAT, samples);
+        for (const auto& [key, t] : targets_) if (!t.depth) ok &= supports(t.fmt, samples);
+        if (ok) break;
+    }
+    LOGI("d3d12: MSAA requested %ux, active %ux%s", requested, samples,
+         samples != requested ? " (device capability fallback)" : "");
+    return samples;
+}
+
+uint32_t D3D12Backend::SamplesForView(D3D12_CPU_DESCRIPTOR_HANDLE view) const {
+    const auto base = rtv_heap_->GetCPUDescriptorHandleForHeapStart().ptr;
+    for (const auto& [key, t] : targets_)
+        if (!t.depth && view.ptr == base + size_t(t.view) * rtv_inc_) return t.res->GetDesc().SampleDesc.Count;
+    return 1;
+}
