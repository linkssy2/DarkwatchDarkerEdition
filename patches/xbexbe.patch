+std::string ShaderCompilerCacheIdentity() {
+    static const auto identity = ShaderCompilerIdentity();
+    if (!identity) return {};
+    std::string result;
+    for (auto b : *identity) { result += "0123456789abcdef"[b >> 4]; result += "0123456789abcdef"[b & 15]; }
+    return result;
+}
+
+bool ShaderCacheContains(const std::string& key) {
+    if (key.size() != 64) return false;
+    ShaderDigest digest{};
+    for (size_t i = 0; i < key.size(); ++i) {
+        const char c = key[i];
+        unsigned n = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : 16;
+        if (n == 16) return false;
+        digest[i / 2] |= uint8_t(n << (i % 2 ? 0 : 4));
+    }
+    ComPtr<ID3DBlob> code;
+    return ReadShaderCache(digest, code);
+}
+
+std::array<BackendShaderSource, kBackendShaderCount> BackendShaderSources() {
+    // Reuse the renderer's exact source and entry names; both participate in cache identity.
+    std::array<BackendShaderSource, kBackendShaderCount> result{{{kBlitHlsl, "vs", "vs_5_0"}, {kBlitHlsl, "psmain", "ps_5_0"},
+             {kDepthHlsl, "vs", "vs_5_0"}, {kDepthHlsl, "psmain", "ps_5_0"},
+             {kDepthMsHlsl, "vs", "vs_5_0"}, {kDepthMsHlsl, "psmain", "ps_5_0"},
+             {kDepthMsHlsl, "resolve", "ps_5_0"}, {PointHlsl(), "main", "gs_5_0"}}};
+    size_t index = 8;
+    for (const auto& shader : Gtao::ShaderSources()) result[index++] = {shader.source, shader.entry, shader.profile};
+    return result;
+}
+
+bool PrepareShaderCache(const std::string& source, const char* profile, std::string& key, const char* entry) {
+    key.clear();
+    if (source.empty() || !entry || !*entry || !profile || (std::strcmp(profile, "vs_5_0") && std::strcmp(profile, "ps_5_0") &&
+        std::strcmp(profile, "gs_5_0") && std::strcmp(profile, "cs_5_0"))) return false;
+    static const auto compiler = ShaderCompilerIdentity(false);
+    if (!compiler) return false;
+    const auto digest = ShaderCacheKey(source, entry, profile, D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, *compiler, false);
+    if (!digest) return false;
+    // Equal recipes share compilation and cannot replace a file another setup worker is reading.
+    static std::array<std::mutex, 64> locks;
+    std::lock_guard lock(locks[(*digest)[0] & 63]);
+    std::string result;
+    for (auto b : *digest) { result += "0123456789abcdef"[b >> 4]; result += "0123456789abcdef"[b & 15]; }
+    ComPtr<ID3DBlob> code;
+    if (!ReadShaderCache(*digest, code, false)) {
+        // Setup owns no renderer state or frame counters, including on worker threads.
+        ComPtr<ID3DBlob> errors;
+        if (FAILED(D3DCompile(source.data(), source.size(), nullptr, nullptr, nullptr, entry, profile,
+            D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, &code, &errors)) ||
+            !WriteShaderCache(*digest, code.Get(), false) || !ReadShaderCache(*digest, code, false)) return false;
+    }
+    key = std::move(result);
+    return true;
+}
+
+bool PrepareVertexShaderCache(const std::vector<uint32_t>& program, uint16_t regs, uint64_t decode, std::string& key) {
+    key.clear();
+    if (program.empty() || program.size() % 4 || program.size() > 136 * 4) return false;
+    return PrepareShaderCache(VertexProgramHlsl(program, regs, decode), "vs_5_0", key);
+}
