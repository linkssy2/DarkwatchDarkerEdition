+bool FindDirectDisc(const fs::path& marker, GameFiles& game) {
+    try {
+        // This receipt is written only after the launcher verifies and prepares the source.
+        constexpr size_t kMaxMarker = 16 * 1024;
+        if (!fs::is_regular_file(fs::symlink_status(marker))) throw std::runtime_error("invalid receipt");
+        std::ifstream stream(marker, std::ios::binary);
+        std::string text(kMaxMarker + 1, '\0');
+        stream.read(text.data(), std::streamsize(text.size()));
+        const auto count = stream.gcount();
+        if (!stream.eof() || count <= 0 || count > kMaxMarker) throw std::runtime_error("invalid receipt size");
+        text.resize(size_t(count));
+        const auto receipt = toml::parse(text);
+        const auto source = receipt["path"].value<std::string>();
+        const auto* declared = receipt["overrides"].as_array();
+        if (receipt["schema_version"].value_or(0) != 1 || !source || source->empty() ||
+                source->find('\0') != std::string::npos || !declared || declared->size() > 32)
+            throw std::runtime_error("invalid receipt fields");
+        const auto iso = fs::u8path(*source);
+        if (!iso.is_absolute() || !fs::is_regular_file(iso)) throw std::runtime_error("missing source image");
+        const auto assets = ExeDir() / "assets";
+        std::set<std::string> seen;
+        std::vector<std::string> overrides;
+        for (const auto& node : *declared) {
+            auto name = node.value<std::string>();
+            if (!name || name->empty() || name->size() > 255 || *name == "." || *name == ".." ||
+                    name->back() == '.' || name->back() == ' ' ||
+                    name->find_first_of("/\\:<>\"|?*") != std::string::npos ||
+                    std::any_of(name->begin(), name->end(), [](unsigned char c) { return c < 32; }))
+                throw std::runtime_error("invalid prepared filename");
+            std::string key = *name;
+            std::transform(key.begin(), key.end(), key.begin(), [](unsigned char c) { return char(std::toupper(c)); });
+            if (!seen.insert(key).second || !fs::is_regular_file(fs::symlink_status(assets / fs::u8path(*name))))
+                throw std::runtime_error("missing or duplicate prepared file");
+            overrides.push_back(std::move(*name));
+        }
+        std::vector<uint8_t> local_xbe;
+        if (fs::file_size(assets / IMAGE_XBE) != kImageSize || !ReadHostFile(assets / IMAGE_XBE, local_xbe) ||
+                local_xbe.size() != kImageSize || Sha1(local_xbe) != kImageSha1)
+            throw std::runtime_error("invalid prepared executable");
+        auto disc = std::make_unique<kernel::Disc>();
+        std::string error;
+        if (!disc->Open(iso, error)) throw std::runtime_error("unreadable source image");
+        const auto* entry = disc->Find(IMAGE_XBE);
+        std::vector<uint8_t> xbe;
+        if (!entry || entry->dir || entry->size != kImageSize || !disc->Load(IMAGE_XBE, xbe) ||
+                Sha1(xbe) != kImageSha1) throw std::runtime_error("unsupported source executable");
+        disc->SetOverrides(std::move(overrides));
+        game = {assets, std::move(xbe)};
+        kernel::MountDisc(std::move(disc));
+        return true;
+    } catch (const std::exception& error) {
+        LOGE("direct ISO: %s", error.what());
+        if (!PreparingShaders()) MessageBoxW(nullptr,
+            L"The selected Xbox ISO or its prepared files are missing or invalid. Keep the ISO available and use the launcher to select it again or verify the installation.",
+            kGame.short_title, MB_ICONERROR);
+        return false;
+    }
