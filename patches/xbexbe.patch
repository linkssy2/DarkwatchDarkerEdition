+namespace gpu {
+
+// User filtering applies to ordinary, mipmapped 2D assets whose spatial filters
+// already interpolate. Keep authored point sampling and screen/depth passes intact.
+// A zero result means no override; 1 explicitly selects the existing 1x behavior.
+inline uint32_t AnisotropyOverride(uint32_t requested,
+                                   const std::array<uint32_t, kTssCount>& t,
+                                   const TexInfo& texture, uint32_t mip_levels,
+                                   bool bound, bool render_target) {
+    if (requested != 1 && requested != 2 && requested != 4 && requested != 8 && requested != 16) return 0;
+    if (!bound || render_target || texture.kind != kTex2D || texture.rect || texture.shadow || mip_levels < 2) return 0;
+    auto interpolates = [](uint32_t filter) { return filter == 2 || filter == 3; };
+    if (!interpolates(t[kTssMinFilter]) || !interpolates(t[kTssMagFilter])) return 0;
+    if (t[kTssMipFilter] != 1 && t[kTssMipFilter] != 2) return 0;
+    return requested;
+}
