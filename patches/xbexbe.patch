+    const double gap = f.started ? std::chrono::duration<double, std::milli>(now - f.previous).count() : 0;
+    f.previous = now;
+    f.started = true;
+    if (gap < 25.0) return;
+    ++f.slow_frames;
+    if (gap <= f.worst_gap) return;
+    f.worst_gap = gap;
+    f.worst_frame = frame;
+    f.worst_capture = capture;
+    f.worst_begin = f.before;
+    f.worst_end = g_perf;
