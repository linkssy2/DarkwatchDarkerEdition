<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darkwatch: Darker Edition" Width="1060" Height="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="#0C0E11" Foreground="#F1E9DA" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F1E9DA"/>
      <Setter Property="Background" Value="#20232A"/>
      <Setter Property="BorderBrush" Value="#696C70"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="#35FFFFFF" Margin="1"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#622026"/><Setter TargetName="Frame" Property="BorderBrush" Value="#C6B9A2"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FAEDD1"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#380D12"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#15181D"/>
      <Setter Property="BorderBrush" Value="#41454C"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F1E9DA"/>
      <Setter Property="Background" Value="#15181D"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Choice" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#622026"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F1E9DA"/>
      <Setter Property="Background" Value="#20232A"/>
      <Setter Property="BorderBrush" Value="#696C70"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="#20232A" BorderBrush="#696C70" BorderThickness="1"><TextBlock Text="▾" Foreground="#F1E9DA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Border x:Name="Focus" BorderBrush="#FAEDD1" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#15181D" BorderBrush="#696C70" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
  <Border Width="1060" Height="720" Background="#0C0E11" BorderBrush="#74777C" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="#111419" BorderBrush="#393C42" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <Image x:Name="SmallInsignia" Width="24" Height="24" Margin="0,0,10,0"/>
            <TextBlock Text="DARKWATCH: DARKER EDITION" Foreground="#C3BDB3" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinimizeButton" Content="—" Width="46" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="Minimize"/>
            <Button x:Name="CloseButton" Content="×" FontSize="22" Width="46" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="Close launcher"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#53545A" BorderThickness="0,0,1,0" Background="#080A0D" ClipToBounds="True">
          <Grid>
            <Image x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Height="3" Background="#7C2026" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="42,24,42,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <Grid>
              <Image x:Name="Insignia" Width="68" Height="68" HorizontalAlignment="Right" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel>
                <TextBlock Text="DARKWATCH" FontFamily="Georgia" FontSize="37" Foreground="#F1E9DA"/>
                <TextBlock Text="D A R K E R   E D I T I O N" Margin="2,8,0,0" FontSize="14" Foreground="#B9635C"/>
              </StackPanel>
            </Grid>
            <Rectangle Height="1" Fill="#56565B" Margin="0,16,0,0"/>
          </StackPanel>
          <Grid Grid.Row="2">
          <StackPanel x:Name="HomePanel" VerticalAlignment="Center">
            <TextBlock x:Name="StateTitle" Text="PREPARE YOUR HUNT" FontFamily="Georgia" FontSize="22"/>
            <TextBlock x:Name="StateDescription" Text="Choose your Xbox ISO or an existing installation to begin." FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="#B8B7B5" Margin="0,10,0,24"/>
            <Grid x:Name="LaunchActions">
              <Button x:Name="ImportButton" Content="SELECT GAME" Background="#701C25" Height="56" FontSize="17"/>
              <Button x:Name="PlayButton" Content="PLAY" Visibility="Collapsed" IsEnabled="False" Height="56" FontSize="17"/>
            </Grid>
            <Button x:Name="ManageButton" Content="MANAGE" Style="{StaticResource Quiet}" Margin="0,10,0,0"/>
          </StackPanel>
          <StackPanel x:Name="SourcePanel" Visibility="Collapsed" VerticalAlignment="Center">
            <DockPanel Margin="0,0,0,16">
              <Button x:Name="SourceBackButton" Content="← BACK" Style="{StaticResource Quiet}" Margin="0,0,16,0"/>
              <TextBlock x:Name="SourceTitle" Text="SELECT GAME" FontFamily="Georgia" FontSize="21" VerticalAlignment="Center"/>
            </DockPanel>
            <Button x:Name="UseIsoButton" Content="USE ISO DIRECTLY" Background="#701C25"/>
            <TextBlock x:Name="UseIsoHint" Text="Play from your Xbox ISO. Keep the ISO in place for future launches." FontSize="12" TextWrapping="Wrap" Foreground="#B8B7B5" Margin="0,7,0,18"/>
            <Button x:Name="ExtractIsoButton" Content="IMPORT ONCE" Style="{StaticResource Quiet}"/>
            <TextBlock x:Name="ExtractIsoHint" Text="Copy the game files once. The ISO can be removed after setup." FontSize="12" TextWrapping="Wrap" Foreground="#B8B7B5" Margin="0,7,0,18"/>
            <Button x:Name="HomeExistingButton" Content="USE EXISTING INSTALL" Style="{StaticResource Quiet}"/>
            <TextBlock x:Name="ExistingHint" Text="Reuse game files, saves and add-ons from a previous installation." FontSize="12" TextWrapping="Wrap" Foreground="#B8B7B5" Margin="0,7,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ManagePanel" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,16">
              <Button x:Name="BackButton" Content="← BACK" Style="{StaticResource Quiet}" Margin="0,0,16,0"/>
              <TextBlock x:Name="ManageTitle" Text="MANAGE GAME" FontFamily="Georgia" FontSize="21" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="FilesTitle" Text="GAME FILES" Foreground="#C8AE89" FontSize="11" Margin="0,0,0,8"/>
            <Grid x:Name="SourceActions">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="ExistingInstallButton" Content="USE EXISTING INSTALL" Style="{StaticResource Quiet}" FontSize="11"/>
              <Button x:Name="RepairIsoButton" Grid.Column="2" Content="REPAIR FROM ISO" Style="{StaticResource Quiet}" FontSize="11"/>
            </Grid>
            <Grid x:Name="RepairActions" Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="VerifyButton" Content="VERIFY FILES" Style="{StaticResource Quiet}" IsEnabled="False"/>
              <Button x:Name="FolderButton" Grid.Column="2" Content="OPEN GAME FOLDER" Style="{StaticResource Quiet}" IsEnabled="False"/>
            </Grid>
            <TextBlock x:Name="ContentTitle" Text="TEXTURES &amp; LANGUAGE" Foreground="#C8AE89" FontSize="11" Margin="0,20,0,8"/>
            <StackPanel x:Name="TextureActions">
              <Button x:Name="TextureButton" Content="INSTALL HD TEXTURES" Style="{StaticResource Quiet}" IsEnabled="False" ToolTip="Set up your game first. Download all HD pack parts into one folder, then select the .001 file. A complete ZIP also works."/>
              <TextBlock x:Name="TextureStatus" Text="Optional download · Gameplay textures not installed" Foreground="#85898F" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="LanguageActions" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="LanguageChoice" SelectedIndex="0" Height="36" IsEnabled="False" AutomationProperties.Name="Game language">
                  <ComboBoxItem Content="English" Tag="en"/>
                  <ComboBoxItem x:Name="SpanishChoice" Content="Español" Tag="es" IsEnabled="False"/>
                </ComboBox>
                <Button x:Name="SpanishButton" Grid.Column="2" Content="INSTALL SPANISH" Height="36" Padding="8,6" Style="{StaticResource Quiet}" IsEnabled="False"/>
              </Grid>
              <TextBlock x:Name="LanguageStatus" Text="Game language · Set up your game first" Foreground="#85898F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="CheckUpdatesButton" Content="CHECK FOR UPDATES" Style="{StaticResource Quiet}" Margin="0,20,0,0"/>
          </StackPanel>
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Checking installation…" FontSize="12" TextWrapping="Wrap" Foreground="#B8B7B5" Margin="0,0,0,10"/>
            <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Foreground="#AA383C" Background="#292D33" BorderThickness="0" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="0,8,0,0"/>
          </StackPanel>
          <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="194"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="DARKER EDITION   /   0.7" Foreground="#676B72" FontSize="10"/>
              <TextBlock x:Name="ReleaseStatus" Text="Check GitHub for updates" Visibility="Collapsed" Foreground="#B8B7B5" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid x:Name="ReleaseActions" Grid.Column="2" Visibility="Collapsed">
              <Button x:Name="ReleaseButton" Content="INSTALL UPDATE" Style="{StaticResource Quiet}" FontSize="10" Padding="6,8"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
  </Viewbox>
</Window>
