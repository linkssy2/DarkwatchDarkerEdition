  "contexts": {
    "8c9285932bbae567": "Zur HÖlle mit diesen Darkwatch-SchlÄgern!",
    "381606c404227cee": "anerkennende Pfiffe",
    "267bf9ce4da5b26c": "Kein Controller",
    "8ab55cf3c0f0dd73": "Controller",
    "bafae4ef1dc0428a": "Controller-Einstellungen",
    "29366b7cd2ca21c8": "DrÜcke ^Crouch, um fortzufahren.",
    "ba42eff05c43acc2": "Halte ^Crouch gedrÜckt, um dich zu ducken. Lass los, um aufzustehen.",
    "e82a927e1f08277a": "Du kannst zwei Waffen gleichzeitig tragen. DrÜcke ^SwitchPrimary^, um die Waffe zu wechseln. DrÜcke ^SwitchSecondary^, um zwischen Dynamit und Splittergranaten zu wechseln.",
    "92d19371cf1dc297": "(TodesrÖcheln)",
    "03396f81dda43768": "Todesschrei.",
    "34b6deecb404f6d0": "Todesschrei, Sturz, abruptes Ende.",
    "b42a3bdb6a86aa75": "Hier bricht die gesamte HÖlle los!",
    "735a7fc8e8d437b4": "(Triumphierendes Lachen, das immer maßloser wird.)",
    "9ad5f792c7be0a3a": "Komm nicht nÄher.",
    "e7276f13d458adac": "Dieses Abzeichen, du bist... du gehÖrst zur Darkwatch.",
    "84b08f4f5fb7daae": "Sag Cartwright, sag ihm, dass die Kristalle verloren sind. Die Minen mÜssen versiegelt werden, die Untoten sind zu stark. Da unten ist etwas Riesiges. Du musst einen anderen Ausgang finden, bevor der Tunnel einstÜrzt.",
    "30cece36f3bdbd5d": "Komm nicht nÄher heran.",
    "6998b42433c50bfe": "Dieses Abzeichen, du bist... du gehÖrst zur Darkwatch.",
    "07bd9703da3799b4": "Sag Cartwright, sag ihm, dass die Kristalle verloren sind. Die Minen mÜssen versiegelt werden, die Untoten sind zu stark. Da unten ist etwas Riesiges. Du musst einen anderen Ausgang finden, bevor der Tunnel einstÜrzt.",
    "673d6af1cd13baff": "leises Lachen",
    "3a16c20419800021": "leises Lachen",
    "a9f774fdf193de1a": "Schwer zu sagen. Es ist ein Wunder, dass er Überhaupt noch lebt.",
    "4e7a95b84fa72576": "Lass mich sterben, bitte lass mich sterben. Lass mich nicht als einer von ihnen zurÜckkommen. Als einer von euch.",
    "a717a817e6d51e8f": "Pfeifen",
    "2064fdbc92f08dd9": "Lachen",
    "637beb71579f2ece": "Gut gemacht, Jericho. Ich wusste, es gibt ein Gewissen da drinnen.",
    "a4f49666f7346413": "Pass auf!",
    "4765650047e3e4d8": "Jaaah!",
    "cc9a8fa4f2564967": "Du verrÜckter Mistkerl!",
    "e316110730f96fe4": "Da haben wir einen Lebendigen!",
    "26f0f7c9ac36c267": "Schnappt ihn!",
    "3b06dae2ca770e99": "Ich bin umzingelt! Hilfe!",
    "5188ac456293cb31": "Du bist mein Held!",
    "10d8ca213b040c66": "-- verschiedene Schreie --",
    "65b6fc7cbc88cd6b": "-- verschiedene Schreie --",
